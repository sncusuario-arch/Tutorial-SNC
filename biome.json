{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": { "enabled": false },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noUnusedTemplateLiteral": "off", "useConst": "off", "noParameterAssign": "off", "useTemplate": "off" },
      "suspicious": { "noAssignInExpressions": "off", "noExplicitAny": "off", "noRedeclare": "off" },
      "complexity": { "noForEach": "off", "useArrowFunction": "off" },
      "correctness": { "noUnusedVariables": "off" }
    }
  },
  "files": { "ignore": ["node_modules"] }
}
